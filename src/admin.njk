---
layout: admin-layout.njk
title: Admin — Deccan Cafe
permalink: "/admin/"
---

<div id="login-screen" class="admin-screen">
  <div class="login-card">
    <p class="login-brand">Deccan Cafe</p>
    <h1>Admin Login</h1>
    <form id="login-form" novalidate>
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" required autocomplete="email" placeholder="you@example.com">
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" required autocomplete="current-password" placeholder="••••••••">
      </div>
      <p id="login-error" class="error-msg" hidden></p>
      <button type="submit" class="btn-primary" id="login-btn">Sign In</button>
    </form>
  </div>
</div>

<div id="dashboard" class="admin-screen" hidden>
  <header class="admin-header">
    <span class="admin-header__title">Deccan Cafe — Menu Manager</span>
    <button id="logout-btn" class="btn-ghost">Sign Out</button>
  </header>

  <main class="admin-main">
    <div class="tab-bar">
      <button class="tab-btn active" data-tab="items">Menu Items</button>
      <button class="tab-btn" data-tab="categories">Categories</button>
    </div>

    <!-- Menu Items tab -->
    <div id="tab-items" class="tab-panel">
      <div class="admin-toolbar">
        <div class="toolbar-left">
          <h2>Menu Items</h2>
          <select id="items-category-filter">
            <option value="">All Categories</option>
          </select>
        </div>
        <button id="add-item-btn" class="btn-primary">+ Add Item</button>
      </div>
      <div id="items-table-container">
        <p id="items-loading-msg" class="table-status">Loading…</p>
        <div class="table-wrap">
          <table id="items-table" hidden>
            <thead>
              <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Sort Order</th>
                <th>Available</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="items-tbody"></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Categories tab -->
    <div id="tab-categories" class="tab-panel" hidden>
      <div class="admin-toolbar">
        <h2>Categories</h2>
        <button id="add-cat-btn" class="btn-primary">+ Add Category</button>
      </div>
      <div id="cats-table-container">
        <p id="cats-loading-msg" class="table-status">Loading…</p>
        <div class="table-wrap">
          <table id="cats-table" hidden>
            <thead>
              <tr>
                <th>Name</th>
                <th>Display Order</th>
                <th>Visible</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="cats-tbody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- Add / Edit Item modal -->
<div id="item-modal" class="modal-overlay" hidden aria-modal="true" role="dialog">
  <div class="modal-card">
    <h2 id="modal-title">Add Item</h2>
    <form id="item-form" novalidate>
      <input type="hidden" id="item-id">
      <div class="form-group">
        <label for="item-name">Name <span class="required">*</span></label>
        <input type="text" id="item-name" required placeholder="e.g. Paneer Dum Biryani">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="item-category">Category <span class="required">*</span></label>
          <select id="item-category" required>
            <option value="">Select…</option>
          </select>
        </div>
        <div class="form-group">
          <label for="item-price">Price ($) <span class="required">*</span></label>
          <input type="number" id="item-price" step="0.01" min="0" required placeholder="0.00">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="item-order">Display Order</label>
          <input type="number" id="item-order" min="1" value="999" placeholder="999">
        </div>
        <div class="form-group form-group--check">
          <label class="check-label">
            <input type="checkbox" id="item-available" checked>
            <span>Available on menu</span>
          </label>
        </div>
      </div>
      <div class="form-group">
        <label for="item-description">Description</label>
        <textarea id="item-description" rows="2" placeholder="Optional short description"></textarea>
      </div>
      <p id="item-form-error" class="error-msg" hidden></p>
      <div class="modal-actions">
        <button type="button" id="item-cancel-btn" class="btn-ghost">Cancel</button>
        <button type="submit" id="item-save-btn" class="btn-primary">Save Item</button>
      </div>
    </form>
  </div>
</div>

<!-- Add / Edit Category modal -->
<div id="cat-modal" class="modal-overlay" hidden aria-modal="true" role="dialog">
  <div class="modal-card modal-card--narrow">
    <h2 id="cat-modal-title">Add Category</h2>
    <form id="cat-form" novalidate>
      <input type="hidden" id="cat-id">
      <div class="form-group">
        <label for="cat-name">Name <span class="required">*</span></label>
        <input type="text" id="cat-name" required placeholder="e.g. Dessert">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="cat-order">Display Order <span class="required">*</span></label>
          <input type="number" id="cat-order" min="1" required placeholder="999">
        </div>
        <div class="form-group form-group--check">
          <label class="check-label">
            <input type="checkbox" id="cat-visible" checked>
            <span>Visible on menu</span>
          </label>
        </div>
      </div>
      <p id="cat-form-error" class="error-msg" hidden></p>
      <div class="modal-actions">
        <button type="button" id="cat-cancel-btn" class="btn-ghost">Cancel</button>
        <button type="submit" id="cat-save-btn" class="btn-primary">Save Category</button>
      </div>
    </form>
  </div>
</div>

<!-- Delete confirmation modal -->
<div id="confirm-delete-modal" class="modal-overlay" hidden aria-modal="true" role="dialog">
  <div class="modal-card modal-card--narrow">
    <h2>Confirm Deletions</h2>
    <p id="confirm-delete-msg" class="confirm-msg"></p>
    <div class="modal-actions">
      <button id="confirm-cancel-btn" class="btn-ghost">Go Back</button>
      <button id="confirm-save-btn" class="btn-danger">Delete &amp; Save</button>
    </div>
  </div>
</div>

<!-- Bulk save bar -->
<div id="save-bar" hidden>
  <span id="save-bar-count"></span>
  <div class="save-bar-actions">
    <button id="discard-btn" class="btn-ghost-light">Discard</button>
    <button id="save-changes-btn" class="btn-primary">Save Changes</button>
  </div>
</div>
