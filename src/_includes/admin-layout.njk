<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or "Admin — Deccan Cafe" }}</title>
  <link rel="apple-touch-icon" sizes="180x180" href="{{ '/images/favicon_io/apple-touch-icon.png' | url }}">
  <link rel="icon" type="image/png" sizes="192x192" href="{{ '/images/favicon_io/web-app-manifest-192x192.png' | url }}">
  <link rel="icon" type="image/png" sizes="512x512" href="{{ '/images/favicon_io/web-app-manifest-512x512.png' | url }}">
  <link rel="manifest" href="{{ '/images/favicon_io/site.webmanifest' | url }}">
  <link rel="shortcut icon" href="{{ '/favicon.ico' | url }}">
  <link rel="stylesheet" href="{{ '/css/admin.css' | url }}">
</head>
<body class="admin-body">
  {{ content | safe }}
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
  <script>
    window.siteConfig = {
      supabase: {
        url: "{{ site.supabaseUrl }}",
        anonKey: "{{ site.supabaseAnonKey }}"
      }
    };
  </script>
  <script src="{{ '/js/admin.js' | url }}"></script>
</body>
</html>
